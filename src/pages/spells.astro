---
// BASE_URL makes links work under both GitHub Pages and a future custom domain.
import spells from '../data/spellbook.json';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Spell reference for the Tear tabletop RPG, generated from structured spreadsheet data.">
<title>Spell Library — Tear RPG</title>
<style is:global>
  :root { color-scheme: light; --bg:#f5f4f0; --paper:#fffefa; --ink:#222523; --muted:#5c645f; --line:#dadbd4; --subtle:#f0f1ec; --accent:#365549; }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.58 system-ui,-apple-system,"Segoe UI",Arial,sans-serif}
  button,input{font:inherit}
  .site-head{border-bottom:1px solid var(--line);background:var(--paper)}
  .site-head-inner{max-width:1180px;margin:auto;padding:16px 28px;display:flex;gap:28px;align-items:center;justify-content:space-between}
  .brand{font:700 24px/1 Georgia,"Times New Roman",serif;letter-spacing:.025em}
  .brand small{font:normal 12px/1.4 system-ui,-apple-system,"Segoe UI",sans-serif;text-transform:uppercase;letter-spacing:.13em;color:var(--muted);display:block;margin-top:6px}
  .site-head-note{font-size:13px;color:var(--muted)}
  .layout{max-width:1180px;margin:38px auto 70px;padding:0 28px;display:grid;grid-template-columns:248px minmax(0,1fr);gap:30px;align-items:start}
  aside{position:sticky;top:24px}
  .section-label{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin:0 0 10px}
  .search{background:var(--paper);border:1px solid var(--line);border-radius:6px;width:100%;padding:11px 12px;color:var(--ink);outline-offset:2px}
  .sidebar-list{margin:15px 0 0;display:grid;gap:5px}
  .spell-nav{border:1px solid transparent;background:transparent;border-radius:6px;text-align:left;padding:11px 12px;cursor:pointer;display:block;width:100%;color:var(--ink);line-height:1.35}
  .spell-nav:hover{background:var(--subtle)}
  .spell-nav[aria-current="true"]{border-color:var(--line);background:var(--paper);font-weight:650}
  .nav-detail{display:block;color:var(--muted);font-size:12px;font-weight:400;margin-top:4px}
  .empty{font-size:13px;color:var(--muted)}
  .page{min-width:0}
  .crumb{font-size:13px;color:var(--muted);margin:0 0 14px}
  .spell-page{border:1px solid var(--line);background:var(--paper);border-radius:8px;padding:36px 42px}
  .eyebrow{font-size:12px;color:var(--accent);font-weight:750;letter-spacing:.10em;text-transform:uppercase;margin:0 0 7px}
  h1{font:normal 38px/1.15 Georgia,"Times New Roman",serif;letter-spacing:-.02em;margin:0 0 7px}
  .subhead{color:var(--muted);font-size:14px;margin:0}
  .section{margin-top:30px;padding-top:26px;border-top:1px solid var(--line)}
  .section h2{font:600 20px/1.25 Georgia,"Times New Roman",serif;margin:0 0 14px}
  .artwork-slot{width:min(100%,236px);aspect-ratio:1;display:block;margin-top:24px;background:linear-gradient(145deg,#fdfdf9,#f7f7f2);border:1px solid var(--line);border-radius:6px;overflow:hidden}
  .artwork-slot img{width:100%;height:100%;object-fit:cover;display:block}
  .sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .method-heading{font-size:12px;font-weight:750;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin:0 0 9px}
  .method-section{margin-top:29px}
  .method-switch{display:flex;flex-wrap:wrap;gap:7px}
  .method-button{cursor:pointer;background:transparent;border:1px solid var(--line);border-radius:5px;padding:9px 17px;color:var(--ink);font-size:14px;font-weight:600;transition:background .12s,border-color .12s}
  .method-button:hover{background:var(--subtle)}
  .method-button[aria-pressed="true"]{background:var(--accent);color:white;border-color:var(--accent)}
  .method-button:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  .stat-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:13px}
  .method-note{margin:10px 0 0;color:var(--muted);font-size:12px;min-height:18px}
  .stat{background:var(--subtle);border-radius:5px;padding:14px 15px}
  .stat-number{display:block;font:600 27px/1.2 Georgia,"Times New Roman",serif;font-variant-numeric:tabular-nums;margin-bottom:5px}
  .stat-label{display:block;font-size:12px;color:var(--muted)}
  .fact-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 20px;margin-top:24px}
  .fact-label{display:block;font-size:12px;color:var(--muted);margin-bottom:2px}
  .fact-value{font-size:15px;font-weight:550}
  .effect{border-left:3px solid var(--accent);padding:2px 0 2px 17px;margin:0;line-height:1.7}
  .description{margin:0;line-height:1.75}
  .casting{display:grid;grid-template-columns:155px 1fr;gap:0}
  .casting dt,.casting dd{padding:11px 0;margin:0;border-bottom:1px solid var(--line);font-size:14px}
  .casting dt{font-weight:650}
  .casting dd{color:#39413c}
  .casting dt:last-of-type,.casting dd:last-of-type{border-bottom:0}
  .microcopy{color:var(--muted);font-size:12px;margin:16px 0 0}
  .footer{max-width:1180px;margin:-34px auto 40px;padding:0 28px;color:var(--muted);font-size:12px}
  @media(max-width:760px){.layout{display:block;margin-top:20px;padding:0 14px}.site-head-inner{padding:13px 18px}.site-head-note{display:none}aside{position:static;margin-bottom:24px}.sidebar-list{display:flex;gap:7px;overflow:auto;padding-bottom:4px}.spell-nav{min-width:155px}.spell-page{padding:24px 20px}h1{font-size:31px}.footer{margin:18px auto 24px;padding:0 16px}}
  @media(max-width:440px){.artwork-slot{width:200px}.method-button{padding:8px 12px;font-size:13px}.method-section .stat-number{font-size:20px} .stat-grid{gap:7px}.stat{padding:10px}.stat-number{font-size:23px}.stat-label{font-size:11px}.fact-grid{gap:14px}.casting{grid-template-columns:1fr}.casting dt{border-bottom:0;padding-bottom:0}.casting dd{padding-top:2px}}

  /* Refined spell reference: compact navigation without horizontal scrolling. */
  select{font:inherit}
  .selector-label{display:block;margin:15px 0 7px;font-size:13px;color:var(--muted);font-weight:600}
  .school-buttons{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .school-button{width:100%;min-width:0;padding:10px 7px;border:1px solid var(--line);background:var(--paper);color:var(--ink);border-radius:6px;cursor:pointer;font:600 13px/1.35 system-ui,sans-serif}
  .school-button:hover{background:var(--subtle)}
  .school-button[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:white}
  .school-button:focus-visible,.geometry-button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .search-results{border:1px solid var(--line);background:var(--paper);border-radius:6px;max-height:260px;overflow-y:auto;margin-top:8px;padding:5px}
  .search-results[hidden]{display:none}
  .search-result{display:block;width:100%;padding:9px;text-align:left;color:var(--ink);border:0;background:transparent;cursor:pointer;border-radius:4px;font-size:13px}
  .search-result:hover,.search-result:focus-visible{background:var(--subtle)}
  .search-result small{display:block;color:var(--muted);font-size:11px}
  .search-result-note{color:var(--muted);font-size:12px;margin:8px}
  .artwork-slot{width:min(100%,280px)}
  .cost-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:26px 0 0}
  .cost-grid .stat{padding:16px 18px}
  .cost-grid .stat-number{font-size:30px}
  .method-specific{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:14px}
  .method-button:not([aria-pressed="true"]){background:var(--paper);color:var(--ink);border-color:#b4bcb6}
  .method-button[aria-pressed="true"]{background:var(--accent);color:white}
  .geometry-button{border:0;border-bottom:1px dashed var(--accent);background:none;color:var(--accent);padding:1px 0;cursor:pointer;text-align:left;font:600 15px/1.4 system-ui,sans-serif}
  .geometry-button:hover{border-bottom-style:solid}
  .hex-dialog{width:min(96vw,480px);max-height:90vh;border:1px solid var(--line);border-radius:9px;padding:22px;background:var(--paper);color:var(--ink);box-shadow:0 20px 70px #0004}
  .hex-dialog::backdrop{background:rgba(22,30,25,.55)}
  .hex-dialog-head{display:flex;align-items:start;justify-content:space-between;gap:16px}
  .hex-dialog h2{font:600 23px/1.25 Georgia,serif;margin:0}
  .dialog-close{background:var(--paper);border:1px solid var(--line);color:var(--ink);border-radius:4px;padding:5px 11px;cursor:pointer}
  .hex-diagram{display:block;width:min(100%,320px);height:auto;margin:16px auto}
  .hex-dialog p{margin:9px 0 0;font-size:13px;color:var(--muted)}
  .attr-control{display:flex;gap:10px;align-items:center;margin-top:16px}
  .attr-control[hidden]{display:none}
  .attr-control input{width:100px;padding:8px;border:1px solid var(--line);border-radius:4px}
  .upgrades-table{border-collapse:collapse;width:100%;font-size:14px}
  .upgrades-table th,.upgrades-table td{text-align:left;vertical-align:top;padding:10px 11px;border-bottom:1px solid var(--line)}
  .upgrades-table th{font-size:12px;color:var(--muted);background:var(--subtle)}
  .upgrades-table td:first-child{width:75px;white-space:nowrap;font-weight:650}
  .upgrades-table tr:last-child td{border-bottom:0}
  @media(max-width:760px){.sidebar-list{display:none}.layout aside{margin-bottom:22px}.spell-page{padding:24px 20px}}
  @media(max-width:440px){.method-specific{gap:8px}.cost-grid{gap:8px}.artwork-slot{width:min(100%,280px)}.upgrades-table th,.upgrades-table td{padding:8px}}
</style>
</head>
<body>
<header class="site-head"><div class="site-head-inner"><a class="brand" href={base} style="color:inherit;text-decoration:none">Tear <small>Tabletop Role-playing Game</small></a><div class="site-head-note"><a href={base} style="color:inherit">Home</a> &nbsp;/&nbsp; Spell Reference</div></div></header>
<div class="layout">
  <aside aria-label="Spell navigation">
    <p class="section-label">Spell Library</p>
    <label for="spell-search" class="selector-label">Search all spells</label>
    <input class="search" id="spell-search" placeholder="Search spells..." autocomplete="off" aria-controls="search-results">
    <div class="search-results" id="search-results" aria-label="Spell search results" hidden></div>
    <label for="college-filter" class="selector-label">College</label>
    <select class="search" id="college-filter" aria-label="Select College"></select>
    <p class="selector-label" id="school-heading">School</p>
    <div class="school-buttons" id="school-buttons" role="group" aria-labelledby="school-heading"></div>
    <label for="spell-select" class="selector-label">Spell</label>
    <select class="search" id="spell-select" aria-label="Select spell"></select>
    <p class="microcopy">Spells imported from the current School snapshots. Incomplete work-in-progress entries retain unspecified fields.</p>
  </aside>
  <main class="page"><div class="crumb" id="crumb">Spells</div><article class="spell-page" id="spell"></article></main>
</div>

<dialog class="hex-dialog" id="hex-dialog" aria-labelledby="hex-title">
  <div class="hex-dialog-head">
    <div><p class="section-label">Hex-grid preview</p><h2 id="hex-title"></h2></div>
    <button type="button" class="dialog-close" id="hex-close" aria-label="Close grid preview">Close</button>
  </div>
  <p id="hex-value"></p>
  <div class="attr-control" id="hex-attribute-control" hidden>
    <label for="hex-attribute" id="hex-attribute-label">Casting attribute</label>
    <input id="hex-attribute" type="number" min="0" max="999" step="1" placeholder="Value" inputmode="numeric">
  </div>
  <div id="hex-visual" aria-live="polite"></div>
  <p id="hex-detail"></p>
  <p>Illustrative hex distances: one hex per meter. Final coverage rules will follow Tear's grid conventions.</p>
</dialog>
<div class="footer">Spell library · Generated from a read-only snapshot of RPG Project Spells.</div>
<script is:inline type="application/json" id="spell-data" set:html={JSON.stringify(spells).replace(/</g, '\\u003c')}></script>
<script is:inline>
const spells = JSON.parse(document.getElementById('spell-data').textContent);
const esc = s => String(s ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const stat = (label,value) => '<div class="stat"><span class="stat-number">'+esc(value||'—')+'</span><span class="stat-label">'+esc(label)+'</span></div>';
const attrFor = {ritual:'CHR',scripted:'INT',sacrifice:'SPR'};
let method='sacrifice';
let selected=spells[0]?.id ?? null;
let currentCollege=spells[0]?.college ?? '';
let currentSchool=spells[0]?.school ?? '';
const sorted = xs => [...xs].sort((a,b)=>a.localeCompare(b));
const unique = xs => sorted(new Set(xs));
const adapt = text => String(text ?? '').replace(/\bATR\b/g,attrFor[method]);
const fmt = text => esc(adapt(text)||'—');
const displayStat = (label,value) => '<div><span class="fact-label">'+esc(label)+'</span><span class="fact-value">'+fmt(value)+'</span></div>';
const geometryStat = (label,value,kind) =>
  '<div><span class="fact-label">'+label+'</span><button type="button" class="geometry-button" data-geometry="'+kind+'" aria-label="View '+label.toLowerCase()+' on a hex grid">'+fmt(value)+' <span aria-hidden="true">⬡</span></button></div>';
const byName = list => [...list].sort((a,b)=>a.name.localeCompare(b.name));
const inSchool = () => byName(spells.filter(s=>s.college===currentCollege && s.school===currentSchool));

function navigateTo(spell) {
  if(!spell)return;
  selected=spell.id;
  currentCollege=spell.college;
  currentSchool=spell.school;
  document.getElementById('spell-search').value='';
  renderNavigation();
  renderSearch();
  renderSpell();
}
function renderNavigation() {
  const collegeSelect=document.getElementById('college-filter');
  const colleges=unique(spells.map(s=>s.college));
  collegeSelect.replaceChildren();
  for(const college of colleges){
    const opt=document.createElement('option');opt.value=college;opt.textContent='College of '+college;
    collegeSelect.add(opt);
  }
  collegeSelect.value=currentCollege;
  const schoolHolder=document.getElementById('school-buttons');
  schoolHolder.replaceChildren();
  const schools=unique(spells.filter(s=>s.college===currentCollege).map(s=>s.school));
  for(const school of schools){
    const button=document.createElement('button');button.type='button';button.className='school-button';
    button.textContent=school;button.setAttribute('aria-pressed',String(school===currentSchool));
    button.addEventListener('click',()=>{
      currentSchool=school;
      const first=inSchool()[0];if(first)navigateTo(first);
    });
    schoolHolder.append(button);
  }
  const picker=document.getElementById('spell-select');picker.replaceChildren();
  for(const spell of inSchool()){
    const option=document.createElement('option');option.value=spell.id;option.textContent=spell.name;
    picker.add(option);
  }
  picker.value=selected;
}
function renderSearch() {
  const q=document.getElementById('spell-search').value.trim().toLowerCase();
  const results=document.getElementById('search-results');
  results.replaceChildren();results.hidden=!q;
  if(!q)return;
  const matches=byName(spells.filter(s=>(s.name+' '+s.school+' '+s.college+' '+s.type).toLowerCase().includes(q)));
  if(!matches.length){
    const p=document.createElement('p');p.className='search-result-note';p.textContent='No matching spells.';results.append(p);return;
  }
  for(const spell of matches.slice(0,30)){
    const button=document.createElement('button');button.className='search-result';button.type='button';
    button.textContent=spell.name;
    const small=document.createElement('small');small.textContent=spell.college+' / '+spell.school;
    button.append(small);
    button.addEventListener('click',()=>navigateTo(spell));
    results.append(button);
  }
  if(matches.length>30){
    const p=document.createElement('p');p.className='search-result-note';
    p.textContent='Showing the first 30 results. Refine your search for more.';results.append(p);
  }
}
function renderSpell(){
  const s=spells.find(x=>x.id===selected);
  if(!s){document.getElementById('spell').textContent='No spells available.';return;}
  document.getElementById('crumb').textContent='Spells / '+s.college+' / '+s.school;
  const methodButtons=[['ritual','Ritual'],['scripted','Scripted'],['sacrifice','Sacrifice']]
    .map(([key,label])=>'<button type="button" class="method-button" data-method="'+key+'" aria-pressed="'+String(key===method)+'">'+label+'</button>').join('');
  let fields=[];
  if(method==='ritual'){
    const m=/^(.*?)\s*\(([^)]*)\)\s*$/.exec(s.ritualTier);
    fields=[['Ritual Tier',m?m[1]:s.ritualTier],['Ritual Time',m?m[2]:'—']];
  }else if(method==='scripted'){
    fields=[['Base Preparation',s.scriptedPrep]];
  }else{
    fields=[['Fatigue',s.fatigue],['Additional Cost',s.additionalCost]];
  }
  const methodHtml=fields.map(([label,value])=>stat(label,adapt(value))).join('');
  const baseLevel=Number(s.level);
  const baseRow=Number.isInteger(baseLevel)&&baseLevel>0
    ? '<tr><td>'+baseLevel+'</td><td>Base spell: '+fmt(s.effect)+'</td></tr>' : '';
  const upgrades=[...(s.upgrades||[])].sort((a,b)=>Number(a.level)-Number(b.level));
  const upgradeRows=upgrades.map(u=>'<tr><td>'+esc(u.level)+'</td><td>'+fmt(u.text)+'</td></tr>').join('');
  const upgradeHtml=baseRow+upgradeRows
    ? '<table class="upgrades-table"><thead><tr><th>Level</th><th>Effect / Upgrade</th></tr></thead><tbody>'+baseRow+upgradeRows+'</tbody></table>'
    : '<p class="microcopy">No upgrades have been specified in the source yet.</p>';

  document.getElementById('spell').innerHTML=
    '<header><p class="eyebrow">'+esc(s.college)+' / '+esc(s.school)+'</p><h1>'+esc(s.name)+'</h1>'+
    '<p class="subhead">Minimum Level '+fmt(s.level)+' · '+fmt(s.type)+' · Element: '+fmt(s.element)+'</p></header>'+
    '<div class="artwork-slot" role="img" aria-label="Space reserved for future illustration of '+esc(s.name)+'">'+
    (s.artwork?'<img src="'+esc(s.artwork)+'" alt="Illustration of '+esc(s.name)+'">':'')+'</div>'+
    (s.incompleteFields?.length?'<p class="microcopy">Work in progress: some spell statistics are not yet specified.</p>':'')+
    '<div class="cost-grid" aria-label="Costs for all casting methods">'+stat('MP Cost · All methods',s.mp)+stat('AP Cost · All methods',s.ap)+'</div>'+
    '<div class="method-section"><p class="method-heading">Casting method</p>'+
    '<div class="method-switch" role="group" aria-label="Casting method">'+methodButtons+'</div>'+
    '<div class="method-specific">'+methodHtml+'</div></div>'+
    '<div class="fact-grid">'+geometryStat('Range',s.range,'range')+
      geometryStat('Area',s.area,'area')+displayStat('Target',s.target)+displayStat('Duration',s.duration)+
      displayStat('Save',s.save)+displayStat('Attack type',s.attackType)+
      displayStat('Sustain cost',s.sustainCost)+displayStat('Sustain range',s.sustainRange)+'</div>'+
    '<section class="section"><h2>Effect</h2><p class="effect">'+fmt(s.effect)+'</p></section>'+
    '<section class="section"><h2>Description</h2><p class="description">'+fmt(s.description)+'</p></section>'+
    '<section class="section"><h2>Upgrades</h2>'+upgradeHtml+'</section>';
  document.getElementById('spell').querySelectorAll('.method-button').forEach(b=>b.addEventListener('click',()=>{
    method=b.dataset.method;renderSpell();
  }));
  document.getElementById('spell').querySelectorAll('.geometry-button').forEach(b=>b.addEventListener('click',()=>openGeometry(b.dataset.geometry)));
}

const hexDialog=document.getElementById('hex-dialog');
const hexValue=document.getElementById('hex-value');
const hexVisual=document.getElementById('hex-visual');
const hexDetail=document.getElementById('hex-detail');
const hexAttribute=document.getElementById('hex-attribute');
const hexAttributeControl=document.getElementById('hex-attribute-control');
const hexTitle=document.getElementById('hex-title');
let redrawGeometry=()=>{};
function drawHexes(distance,kind,mode){
  // Hexes use axial coordinates. We deliberately cap oversized views and label the crop.
  const gridR=Math.max(2,Math.min(5,Math.ceil(distance)+1));
  const size=Math.min(22,120/(Math.sqrt(3)*gridR));
  const cx=142,cy=136,polygons=[];
  for(let q=-gridR;q<=gridR;q++){
    for(let r=-gridR;r<=gridR;r++){
      const d=Math.max(Math.abs(q),Math.abs(r),Math.abs(q+r));
      if(d>gridR)continue;
      const x=cx+Math.sqrt(3)*size*(q+r/2), y=cy+1.5*size*r;
      const points=Array.from({length:6},(_,k)=>{
        const a=(60*k-30)*Math.PI/180;
        return (x+size*Math.cos(a)).toFixed(2)+','+(y+size*Math.sin(a)).toFixed(2);
      }).join(' ');
      let fill='#f5f4f0';
      if(mode==='self')fill=d===0?'#365549':'#f5f4f0';
      else if(mode==='touch')fill=d===0?'#365549':d===1?'#c8ddce':'#f5f4f0';
      else if(d<=distance)fill=d===0?'#365549':'#c8ddce';
      polygons.push('<polygon points="'+points+'" fill="'+fill+'" stroke="#8ea99b" stroke-width="1"/>');
    }
  }
  polygons.push('<circle cx="'+cx+'" cy="'+cy+'" r="4" fill="#fff" stroke="#365549" stroke-width="1.4"/>');
  hexVisual.innerHTML='<svg class="hex-diagram" viewBox="0 0 284 272" role="img" aria-label="Illustrative hex grid for '+kind+'">'+polygons.join('')+'</svg>';
  hexDetail.textContent=mode==='touch'
    ? 'Touch: adjacent hexes are shaded as an illustration, not a finalized targeting rule.'
    : mode==='self'?'Self: caster hex highlighted.'
    : (distance>gridR?'Showing the nearest '+gridR+' hex steps of '+distance+' m. The full distance extends beyond the diagram.'
    : 'Highlighted hexes are within '+distance+' m of the caster.');
}
function openGeometry(kind){
  const s=spells.find(x=>x.id===selected);
  const raw=String(kind==='area'?s.area:s.range||'').trim();
  const field=String(kind==='area'?s.area:s.range||'').trim();
  hexTitle.textContent=s.name+' — '+(kind==='area'?'Area':'Range');
  hexValue.textContent=(kind==='area'?'Area: ':'Range: ')+(adapt(field)||'Unspecified');
  hexAttribute.value='';hexAttributeControl.hidden=true;
  const numeric=/(\d+(?:\.\d+)?)\s*(?:[×x*]\s*ATR)?\s*m\b/i.exec(field);
  const usesAtr=/[×x*]\s*ATR\b/i.test(field);
  redrawGeometry=()=>{
    if(numeric){
      const a=Number(numeric[1]);
      if(usesAtr&&!hexAttribute.value){
        hexVisual.textContent='Enter your '+attrFor[method]+' value to calculate the distance.';
        hexDetail.textContent='The spell sheet specifies a distance that depends on your casting attribute.';
        return;
      }
      const distance=a*(usesAtr?Number(hexAttribute.value):1);
      if(!Number.isFinite(distance)||distance<0){
        hexVisual.textContent='Enter a valid, nonnegative attribute value.';hexDetail.textContent='';return;
      }
      drawHexes(distance,kind,'radius');return;
    }
    if(/^self$/i.test(field)){drawHexes(0,kind,'self');return;}
    if(/^touch$/i.test(field)){drawHexes(1,kind,'touch');return;}
    hexVisual.textContent='No fixed numeric hex footprint is specified for this '+kind+'.';
    hexDetail.textContent='Refer to the spell’s written rules: '+(adapt(field)||'Unspecified')+'.';
  };
  if(usesAtr&&numeric){
    hexAttributeControl.hidden=false;
    document.getElementById('hex-attribute-label').textContent=attrFor[method]+' value';
  }
  redrawGeometry();
  hexDialog.showModal();
}
hexAttribute.addEventListener('input',()=>redrawGeometry());
document.getElementById('hex-close').addEventListener('click',()=>hexDialog.close());
hexDialog.addEventListener('click',e=>{
  if(e.target===hexDialog)hexDialog.close();
});
document.getElementById('spell-search').addEventListener('input',renderSearch);
document.getElementById('college-filter').addEventListener('change',e=>{
  currentCollege=e.target.value;
  currentSchool=unique(spells.filter(s=>s.college===currentCollege).map(s=>s.school))[0]||'';
  navigateTo(inSchool()[0]);
});
document.getElementById('spell-select').addEventListener('change',e=>{
  navigateTo(spells.find(s=>s.id===e.target.value));
});
if(spells.length){renderNavigation();renderSearch();renderSpell();}
else{document.getElementById('spell').textContent='No spell data is available.';}
</script>
</body>
</html>