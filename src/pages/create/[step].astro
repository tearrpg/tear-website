---
import SiteLayout from '../../layouts/SiteLayout.astro';
import {characterSteps} from '../../data/site-map.mjs';
export function getStaticPaths(){return characterSteps.filter(s=>!['species','facets'].includes(s.slug)).map(entry=>({params:{step:entry.slug},props:{entry}}));}
const {entry}=Astro.props;
const i=characterSteps.findIndex(s=>s.slug===entry.slug);
const prev=characterSteps[i-1];
const next=characterSteps[i+1];
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';
---
<SiteLayout title={entry.title} section="create">
 <div class="tw-page tw-article">
  <nav class="tw-breadcrumbs" aria-label="Breadcrumb"><a href={base}>Home</a><span class="tw-sep">/</span><a href={base+'create/species/'}>Create a Character</a><span class="tw-sep">/</span><span>{entry.title}</span></nav>
  <p class="tw-eyebrow">Character creation · Step {i+1}</p><h1 class="tw-page-title">{entry.title}</h1>
  <p class="tw-lede">{entry.description}</p>
  <nav class="tw-steps" aria-label="Character creation steps">
   {characterSteps.map((s,j)=><a class="tw-step" aria-current={i===j?'step':undefined} href={base+'create/'+s.slug+'/'}>{j+1}. {s.title}</a>)}
  </nav>
  {entry.slug!=='finish'?<section class="tw-panel"><h3>Guide content to come</h3><p class="tw-placeholder-text">This page establishes the next step in the guided journey. Specific rules, choices, and character-sheet instructions will be added when this step is developed.</p></section>:
  <section class="tw-panel"><h3>Your next adventure</h3><p>The guided steps are mapped, but the digital character builder and character-sheet download are not ready. Both remain explicit design decisions.</p><div class="tw-actions" style="margin-top:20px"><a class="tw-btn tw-btn-outline" href={base+'rules/core/'}>Learn How to Play</a><a class="tw-btn tw-btn-outline" href={base+'world/'}>Explore the World</a></div></section>}
  <nav class="tw-guide-nav"><a class="tw-btn tw-btn-outline" href={base+'create/'+prev.slug+'/'}>← {prev.title}</a>{next?<a class="tw-btn tw-btn-primary" href={base+'create/'+next.slug+'/'}>Continue to {next.title} →</a>:<a class="tw-btn tw-btn-outline" href={base}>Return Home →</a>}</nav>
 </div>
</SiteLayout>